# ═══════════════════════════════════════════════════════════════════════════════
# SmartCow API — Variables de entorno
# Copiar este archivo a .env y completar todos los valores antes de arrancar.
# NUNCA commitear el archivo .env al repositorio.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development                   # development | staging | production
PORT=4000                              # Puerto del servidor HTTP
API_PREFIX=/api/v1                     # Prefijo global de rutas REST

# ── Base de datos (PostgreSQL 15) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/smartcow_db
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# En producción usar connection pooling: postgresql://...?pgbouncer=true

# ── Redis 7 ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# En producción con Upstash: rediss://USER:PASSWORD@HOST:PORT
REDIS_KEY_PREFIX=smartcow:            # Prefijo para todas las claves Redis

# ── JWT RS256 ─────────────────────────────────────────────────────────────────
# Generar par de claves con: chmod +x scripts/gen-keys.sh && ./scripts/gen-keys.sh
# Pegar el contenido completo del archivo (incluyendo cabeceras -----BEGIN...----- )
# Las claves deben tener saltos de línea reales, no literales \n
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...
...líneas de la clave...
-----END RSA PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
...líneas de la clave...
-----END PUBLIC KEY-----"

JWT_ACCESS_EXPIRES_IN=8h              # Expiración del access token (8 horas)
JWT_REFRESH_EXPIRES_IN=30d            # Expiración del refresh token (30 días)

# ── 2FA TOTP ──────────────────────────────────────────────────────────────────
# Clave de 32 caracteres hexadecimales para cifrar los secretos TOTP en BD
# Generar con: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=your_32_char_hex_key_here_000000000000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173      # URL del frontend (Vite dev server)
# En producción: https://app.smartcow.app

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000            # Ventana de tiempo en ms (1 minuto)
RATE_LIMIT_MAX=100                    # Máximo de requests por ventana (general)
RATE_LIMIT_AUTH_MAX=10                # Máximo en /login y /register

# ── MQTT (Mosquitto Broker) ───────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883 # URL del broker. En producción: mqtts://host:8883
MQTT_URL=mqtt://localhost:1883        # Alias legado (MQTT_BROKER_URL tiene prioridad)
MQTT_CLIENT_ID=smartcow-api-dev       # Identificador único del cliente MQTT
MQTT_USERNAME=smartcow_backend
MQTT_PASSWORD=your_mqtt_password_here
# Topics suscritos (configurables — defaults según api-contracts.md)
MQTT_TOPIC_TELEMETRY=smartcow/farms/+/animals/+/telemetry
MQTT_TOPIC_STATUS=smartcow/devices/+/status

# ── BullMQ (usa la misma conexión Redis) ──────────────────────────────────────
# Las colas BullMQ usan REDIS_URL, no se necesita variable adicional
BULL_BOARD_USER=admin                 # Usuario para el dashboard de BullMQ
BULL_BOARD_PASSWORD=your_bull_password

# ── SendGrid (notificaciones email) ───────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alertas@smartcow.app
SENDGRID_FROM_NAME=SmartCow Tracker

# ── Twilio (notificaciones SMS) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890       # Número Twilio en formato E.164

# ── Servicio IA (Python FastAPI) ───────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000  # URL del microservicio smartcow-ai
AI_SERVICE_TIMEOUT_MS=5000            # Timeout para llamadas al servicio IA
AI_CIRCUIT_BREAKER_THRESHOLD=3        # Fallos consecutivos antes de abrir circuito

# ── Almacenamiento de archivos (S3 / compatible) ──────────────────────────────
S3_BUCKET=smartcow-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_ENDPOINT=                          # Dejar vacío para AWS S3. MinIO: http://localhost:9000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                        # debug | info | warn | error
LOG_PRETTY=true                       # true en dev (colores), false en producción (JSON puro)

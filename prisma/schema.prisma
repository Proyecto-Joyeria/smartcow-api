// ═══════════════════════════════════════════════════════════════════════════════
// SmartCow Tracker — Prisma Schema v0.1.0 (Sprint 1)
// Modelos: Farm, User, UserFarm, RefreshToken
// Tipos según SmartCow_DataModel_v1.0.0: CUID2 para IDs, TIMESTAMPTZ para fechas
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VET
  OPERATOR
}

enum Breed {
  BRAHMAN
  HOLSTEIN
  ANGUS
  SIMMENTAL
  CEBUINO
  OTRO
}

enum Sex {
  M
  F
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  TRANSFERRED
}

enum HealthStatus {
  HEALTHY
  SICK
  RECOVERING
  UNDER_OBSERVATION
  CRITICAL
}

enum ReproductiveStatus {
  OPEN
  PREGNANT
  LACTATING
  DRY
  CULLED
}

/// Prioridad de una alerta (Sprint 5). Determina el canal de notificación:
/// INFO → solo web · WARNING → web + email · CRITICAL → web + email + SMS.
enum AlertPriority {
  CRITICAL
  WARNING
  INFO
}

/// Ciclo de vida de una alerta (Sprint 5).
/// OPEN → ACKNOWLEDGED → (ASSIGNED) → CLOSED.
enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  ASSIGNED
  CLOSED
}

// ── Modelos Sprint 1 ──────────────────────────────────────────────────────────

/// Finca ganadera — unidad principal de aislamiento multi-tenant.
/// Todos los recursos del sistema (animales, geocercas, alertas) pertenecen a una Farm.
model Farm {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  timezone    String   @default("America/Bogota") @db.VarChar(50)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz() @map("updated_at")

  userFarms     UserFarm[]
  refreshTokens RefreshToken[]
  animals       Animal[]
  devices       Device[]
  geofences     Geofence[]
  alerts        Alert[]

  @@map("farms")
}

/// Usuario del sistema. Un usuario puede pertenecer a múltiples fincas con roles distintos.
/// La contraseña se almacena como hash bcrypt factor 12 — nunca en texto plano.
/// El secreto 2FA se almacena cifrado con AES-256 usando TWO_FACTOR_ENCRYPTION_KEY.
model User {
  id           String   @id @default(cuid()) @db.VarChar(30)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.Text @map("password_hash")
  firstName    String   @db.VarChar(100) @map("first_name")
  lastName     String   @db.VarChar(100) @map("last_name")
  phone        String?  @db.VarChar(20)

  /// Secreto TOTP cifrado en reposo con AES-256 (TWO_FACTOR_ENCRYPTION_KEY)
  twoFactorSecret  String?  @db.Text @map("two_factor_secret")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")

  /// Contador de intentos fallidos de login. Se resetea en login exitoso.
  loginAttempts Int       @default(0) @map("login_attempts")
  /// Cuando no es null, la cuenta está bloqueada hasta esta fecha.
  lockedUntil   DateTime? @db.Timestamptz() @map("locked_until")
  lastLoginAt   DateTime? @db.Timestamptz() @map("last_login_at")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz() @map("updated_at")

  userFarms     UserFarm[]
  refreshTokens RefreshToken[]
  createdGeofences Geofence[]    @relation("GeofenceCreatedBy")
  assignedAlerts   Alert[]       @relation("AlertAssignee")
  alertActions     AlertAction[]
  auditLogs        AuditLog[]

  @@index([email])
  @@map("users")
}

/// Relación N:M entre User y Farm con rol por finca.
/// Un usuario puede ser ADMIN en una finca y OPERATOR en otra.
model UserFarm {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @db.VarChar(30) @map("user_id")
  farmId    String   @db.VarChar(30) @map("farm_id")
  role      UserRole
  createdAt DateTime @default(now()) @db.Timestamptz() @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  /// Un usuario solo puede tener un rol por finca
  @@unique([userId, farmId])
  @@index([farmId])
  @@index([userId])
  @@map("user_farms")
}

/// Refresh tokens para rotación JWT.
/// Se almacena el HASH SHA-256 del token, nunca el token raw.
/// El token raw va en cookie HttpOnly Secure SameSite=Strict.
model RefreshToken {
  id        String    @id @default(cuid()) @db.VarChar(30)
  /// SHA-256 del token raw. Permite buscar sin exponer el token en BD.
  tokenHash String    @unique @db.VarChar(64) @map("token_hash")
  userId    String    @db.VarChar(30) @map("user_id")
  farmId    String    @db.VarChar(30) @map("farm_id")
  expiresAt DateTime  @db.Timestamptz() @map("expires_at")
  /// Cuando no es null el token fue revocado (logout o rotación)
  revokedAt DateTime? @db.Timestamptz() @map("revoked_at")
  createdAt DateTime  @default(now()) @db.Timestamptz() @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── Modelos Sprint 2 ──────────────────────────────────────────────────────────

/// Bovino registrado en la finca. Soft delete via deletedAt.
/// Identificado unívocamente por el par (farmId, code) — código interno de la finca.
model Animal {
  id                 String              @id @default(cuid()) @db.VarChar(30)
  farmId             String              @db.VarChar(30) @map("farm_id")
  code               String              @db.VarChar(30)
  name               String?             @db.VarChar(100)
  breed              Breed
  sex                Sex
  birthDate          DateTime?           @db.Timestamptz() @map("birth_date")
  weightKg           Decimal?            @db.Decimal(6, 2) @map("weight_kg")
  photoUrl           String?             @db.Text @map("photo_url")
  areteNumber        String?             @db.VarChar(30) @map("arete_number")
  status             AnimalStatus        @default(ACTIVE)
  healthStatus       HealthStatus        @default(HEALTHY) @map("health_status")
  reproductiveStatus ReproductiveStatus? @map("reproductive_status")
  notes              String?             @db.Text
  deletedAt          DateTime?           @db.Timestamptz() @map("deleted_at")
  createdAt          DateTime            @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt          DateTime            @updatedAt @db.Timestamptz() @map("updated_at")

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  /// Dispositivo IoT actualmente asignado a este animal (FK está en Device)
  device Device?
  alerts Alert[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([farmId, deletedAt])
  @@map("animals")
}

/// Collar IoT (dispositivo GPS/sensores). Un device puede estar asignado a un solo animal.
/// El id es UUID v4 — coincide con el campo `d` del payload MQTT.
model Device {
  id              String    @id @default(uuid()) @db.Uuid
  farmId          String    @db.VarChar(30) @map("farm_id")
  /// Animal al que está asignado actualmente; null = sin asignar
  animalId        String?   @unique @db.VarChar(30) @map("animal_id")
  serialNumber    String    @unique @db.VarChar(50) @map("serial_number")
  firmwareVersion String    @db.VarChar(20) @map("firmware_version")
  /// Huella digital del certificado TLS del collar
  certFingerprint String?   @unique @db.Text @map("cert_fingerprint")
  certExpiresAt   DateTime? @db.Timestamptz() @map("cert_expires_at")
  batteryPct      Int?      @map("battery_pct")
  lastSeenAt      DateTime? @db.Timestamptz() @map("last_seen_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt       DateTime  @updatedAt @db.Timestamptz() @map("updated_at")

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@map("devices")
}

// ── Modelos Sprint 3 ──────────────────────────────────────────────────────────
// Tablas de telemetría de alta frecuencia (un INSERT por animal cada ~10s).
// Diseño deliberado:
//   - id BigInt autoincrement → BIGSERIAL, soporta miles de millones de filas.
//   - farmId DESNORMALIZADO (sin FK) → evita el overhead de validación referencial
//     en cada escritura y permite filtrar por finca sin JOIN. El aislamiento
//     multi-tenant se garantiza en la capa de repositorio (siempre se filtra por farmId).
//   - Índices compuestos (entidad, recordedAt DESC) → optimizan la query típica:
//     "últimas N lecturas de este animal/finca ordenadas por fecha".

/// Histórico de posiciones GPS. Fuente de verdad para reproducción de rutas.
/// El flujo en tiempo real NO lee de aquí — lee de Redis. Esta tabla la escribe
/// el worker persist-gps de forma asíncrona vía Bull MQ.
model GpsHistory {
  id         BigInt   @id @default(autoincrement())
  animalId   String   @db.VarChar(30) @map("animal_id")
  farmId     String   @db.VarChar(30) @map("farm_id")
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  alt        Decimal? @db.Decimal(7, 2)
  accuracy   Decimal? @db.Decimal(6, 2)
  speedKmh   Decimal? @db.Decimal(6, 2) @map("speed_kmh")
  recordedAt DateTime @db.Timestamptz() @map("recorded_at")

  @@index([animalId, recordedAt(sort: Desc)])
  @@index([farmId, recordedAt(sort: Desc)])
  @@map("gps_history")
}

/// Histórico de signos vitales (temperatura, ritmo cardíaco, actividad, batería).
/// Misma estrategia de escritura asíncrona y denormalización que GpsHistory.
model VitalHistory {
  id         BigInt   @id @default(autoincrement())
  animalId   String   @db.VarChar(30) @map("animal_id")
  farmId     String   @db.VarChar(30) @map("farm_id")
  tempC      Decimal  @db.Decimal(4, 1) @map("temp_c")
  heartBpm   Int      @map("heart_bpm")
  activity   Int
  batteryPct Int      @map("battery_pct")
  recordedAt DateTime @db.Timestamptz() @map("recorded_at")

  @@index([animalId, recordedAt(sort: Desc)])
  @@index([farmId, recordedAt(sort: Desc)])
  @@map("vital_history")
}

// ── Modelos Sprint 4 — Geocercas ───────────────────────────────────────────────

/// Geocerca poligonal de una finca. El polígono se guarda como JSON (array de
/// {lat, lng}, mín. 3 y máx. 50 vértices). La evaluación Point-in-Polygon se hace
/// en la capa de aplicación con ray casting (ver geofence.geometry.ts), por lo que
/// no se requiere la extensión PostGIS: es una decisión deliberada del DevPlan.
/// Solo las geocercas `active` disparan alertas GEOFENCE_EXIT.
model Geofence {
  id          String   @id @default(cuid()) @db.VarChar(30)
  farmId      String   @db.VarChar(30) @map("farm_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  /// Array de vértices [{ lat, lng }, ...]. Validado por Zod (3..50 vértices).
  polygon     Json     @db.JsonB
  color       String   @default("#1a7a4a") @db.Char(7)
  active      Boolean  @default(true)
  createdBy   String   @db.VarChar(30) @map("created_by")
  createdAt   DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz() @map("updated_at")

  farm    Farm   @relation(fields: [farmId], references: [id], onDelete: Restrict)
  creator User   @relation("GeofenceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  alerts  Alert[]

  @@index([farmId, active])
  @@map("geofences")
}

// ── Modelos Sprint 5 — Motor de Alertas ────────────────────────────────────────

/// Alerta generada por el motor de reglas (patrón Strategy). Ciclo de vida
/// completo OPEN → ACKNOWLEDGED → (ASSIGNED) → CLOSED. `response_ms` se calcula
/// al cerrar (opened_at → closed_at) para las métricas de tiempo de respuesta.
model Alert {
  id          String        @id @default(cuid()) @db.VarChar(30)
  farmId      String        @db.VarChar(30) @map("farm_id")
  animalId    String        @db.VarChar(30) @map("animal_id")
  /// Geocerca involucrada — solo en alertas GEOFENCE_EXIT. SET NULL al borrarla.
  geofenceId  String?       @db.VarChar(30) @map("geofence_id")
  /// Id de la regla que la disparó. Ej: HIGH_TEMP, GEOFENCE_EXIT, SENSOR_OFFLINE.
  ruleId      String        @db.VarChar(50) @map("rule_id")
  priority    AlertPriority
  status      AlertStatus   @default(OPEN)
  title       String        @db.VarChar(200)
  description String        @db.Text
  /// Contexto del evento: { tempC, threshold, lat, lng, ... }
  metadata    Json?         @db.JsonB
  assigneeId  String?       @db.VarChar(30) @map("assignee_id")
  resolution  String?       @db.Text
  openedAt    DateTime      @default(now()) @db.Timestamptz() @map("opened_at")
  closedAt    DateTime?     @db.Timestamptz() @map("closed_at")
  responseMs  Int?          @map("response_ms")

  farm     Farm          @relation(fields: [farmId], references: [id], onDelete: Restrict)
  animal   Animal        @relation(fields: [animalId], references: [id], onDelete: Restrict)
  geofence Geofence?     @relation(fields: [geofenceId], references: [id], onDelete: SetNull)
  assignee User?         @relation("AlertAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  actions  AlertAction[]

  @@index([farmId, status, priority])
  @@index([animalId, openedAt(sort: Desc)])
  @@index([farmId, openedAt(sort: Desc)])
  @@index([farmId, ruleId, openedAt])
  @@map("alerts")
}

/// Historial de acciones sobre una alerta (reconocer, asignar, cerrar). Es el log
/// de auditoría específico del ciclo de vida de la alerta. Se borra en cascada con
/// la alerta. `userId` es null cuando la acción la ejecuta el sistema (CREATED).
model AlertAction {
  id        BigInt   @id @default(autoincrement())
  alertId   String   @db.VarChar(30) @map("alert_id")
  userId    String?  @db.VarChar(30) @map("user_id")
  /// Acción: CREATED | ACKNOWLEDGED | ASSIGNED | CLOSED
  action    String   @db.VarChar(30)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz() @map("created_at")

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([alertId])
  @@map("alert_actions")
}

/// Log de auditoría global e inmutable (§3.12 DataModel). Registra acciones
/// sensibles del sistema: acciones sobre alertas, gestión de geocercas, etc.
/// La aplicación solo hace INSERT — nunca UPDATE ni DELETE.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @db.VarChar(30) @map("user_id")
  farmId     String?  @db.VarChar(30) @map("farm_id")
  action     String   @db.VarChar(50)
  entityType String?  @db.VarChar(30) @map("entity_type")
  entityId   String?  @db.VarChar(30) @map("entity_id")
  oldValues  Json?    @db.JsonB @map("old_values")
  newValues  Json?    @db.JsonB @map("new_values")
  ipAddress  String?  @db.Inet @map("ip_address")
  userAgent  String?  @db.Text @map("user_agent")
  occurredAt DateTime @default(now()) @db.Timestamptz() @map("occurred_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([action])
  @@index([occurredAt])
  @@map("audit_logs")
}
